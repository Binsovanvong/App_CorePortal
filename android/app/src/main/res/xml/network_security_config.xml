<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, enforce HTTPS for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext exemption scoped strictly to internal development & UAT endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">uat-app-core.interior.gov.kh</domain>
        <domain includeSubdomains="true">172.30.192.1</domain>
        <domain includeSubdomains="true">172.30.192.127</domain>
        <domain includeSubdomains="true">172.30.192.253</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <!-- In debug builds only, permit user CAs for testing. Release builds strictly enforce system CAs -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
